# ---- 镜像与二进制（不上传）----
*.img
*.bin
!prebuilt/uefi/BootShim.bin
*.apfs
*.elf
*.fd
# prebuilt/uefi/ holds the two inputs mkxnuimg.py needs for a boot image: the UEFI firmware
# (2 MB) and BootShim (176 bytes). Both come from the EDK2 tree, which is not in this repository.
!prebuilt/uefi/SILICIUM_UEFI.fd
# umi's own firmware, kept beside redwood's so the fallback picks the right one per device.
!prebuilt/uefi/umi/SILICIUM_UEFI.fd
*.dylib
*.dmg
*.iso
# umi.dtb IS needed: common/build.sh passes it to mkxnuimg.py to append the device tree to the
# boot image. It is 946 KB and there is no way to regenerate it without the phone.
# (out/umi-uefi.img already has this DTB embedded, but rebuilding it does not.)

# ---- 上游大仓库（按需自行拉取）----
Mu-Silicium/
qemu/
ios165/
xnu-deps/
.build/theos/
.build/gt9886/
.venv-linux/
.userland.git/

# ---- 构建产物 ----
xnu-src/
out/
# The one exception: the boot image is 2 MB and needs a 5.3 GB EDK2 tree to rebuild, so it is
# kept here. The kernel payload next to it (out/umi-final.bin) is NOT kept: it is 20 MB of
# re-buildable output that goes stale the moment a driver changes, and it is useless without the
# 2.3 GB system.apfs anyway.
!out/umi-uefi.img
userland/obj/
userland/root/
.build/*.log
logs/
*.o
*.cpo
*.dSYM/

# ---- 系统与编辑器 ----
.DS_Store
__pycache__/
*.pyc
.idea/
.vscode/

# ---- 大数据备份 ----
umi-backup/

# ---- 不该进仓库的二进制 ----
prebuilt/mach.development.bcm2837
.build/shim/tar
.build/shim/sed
.build/shim/awk
.build/shim/timeout
.build/shim/stat
.build/shim/7z
.build/shim/cc
